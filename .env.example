# Set to the final HTTPS domain, without a trailing slash.
NEXT_PUBLIC_SITE_URL=https://example.com
# Optional: create a real Formspree form and enter its endpoint here.
# File attachments may require a paid Formspree plan. Verify delivery before enabling.
FORM_ENDPOINT=

# Enable only after testing attachments with a compatible provider plan.
FORM_UPLOADS_ENABLED=false
